PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Opcional: exige este valor no cabeçalho X-Device-Key de POST /api/telemetry.
TELEMETRY_DEVICE_KEY=
# Opcional: após este intervalo sem uma leitura, o sensor passa a ser informado como desatualizado.
TELEMETRY_STALE_MS=30000
# Optional path for the revisioned public MAX6675 calibration command.
CALIBRATION_FILE=calibration.json
